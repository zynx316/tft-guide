{
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run qa:*)",
      "Bash(npm run qa)",
      "Bash(npm start)",
      "Bash(node tools/check.mjs:*)",
      "Bash(node qa/run-qa.mjs:*)",
      "Bash(node server.mjs:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git -C * status:*)",
      "Bash(git -C * log:*)",
      "Bash(git -C * branch:*)",
      "Bash(git -C * rev-parse:*)",
      "Bash(git -C * ls-files:*)",
      "Bash(git -C * diff --stat:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(npm install:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git checkout -- :*)",
      "Bash(git restore:*)",
      "Bash(git push --force:*)",
      "Bash(git -C * add:*)",
      "Bash(git -C * commit:*)",
      "Bash(git -C * push:*)",
      "Bash(git -C * reset:*)",
      "Bash(git -C * stash:*)",
      "Bash(git -C * checkout:*)"
    ]
  }
}
